# Optional. Without a key the app runs in extractive mode (quotes the documents).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Vector store: leave empty to use embedded Qdrant under ./data, or point to a Qdrant server / Qdrant Cloud.
QDRANT_URL=
RAG_DATA_DIR=data

# Models (downloaded on first run, then cached)
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base   # "none" to disable reranking

# Retrieval
RAG_CHUNK_CHARS=600
RAG_TOP_K=5
RAG_CANDIDATES=8
RAG_MIN_RERANK=-5.0

# Index the sample PDFs on first start (1/0)
SEED_SAMPLES=1
